{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Absen Kelas",
  "version": "0.1.9",
  "identifier": "id.opensource.absenkelas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Absen Kelas",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Input dan rekap absensi siswa per jam pelajaran.",
    "longDescription": "Absen Kelas membantu operator sekolah merekap absensi siswa dari buku absen fisik ke laporan digital tanpa backend dan tanpa biaya server."
  }
}
